@page
@model Portfolio.Pages.Admin.Certificate.EditCertificateModel
@{
    ViewData["Title"] = "ویرایش مدرک";
}

<div class="text-center">
    <h1>ویرایش مدرک</h1>
</div>

<br />

<div class="row">
    <div class="col-12">
        <form method="post" enctype="multipart/form-data">
            
            <div class="form-group">
                <label asp-for="Certificate.Title">عنوان</label>
                <input asp-for="Certificate.Title" class="form-control" />
                <span asp-validation-for="Certificate.Title" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Certificate.ImagePath">لینک عکس</label>
                <input asp-for="Certificate.ImagePath" class="form-control" />
                <span asp-validation-for="Certificate.ImagePath" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Certificate.VerificationLink">لینک صحت سنجی</label>
                <input asp-for="Certificate.VerificationLink" class="form-control" />
                <span asp-validation-for="Certificate.VerificationLink" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Certificate.Description">توضیحات (اختیاری)</label>
                <textarea asp-for="Certificate.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Certificate.Description" class="text-danger"></span>
            </div>

            <br />

            <input type="submit" class="btn btn-warning" value="ویرایش" />
            <a asp-page="/Admin/Index" class="btn btn-secondary">انصراف</a>

        </form>
    </div>
</div>
