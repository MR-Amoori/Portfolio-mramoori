@page
@model Portfolio.Pages.Admin.Certificate.DeleteCertificateModel
@{
    ViewData["Title"] = "حذف مدرک";
}

<div class="text-center">
    <h1>آیا مطمئن هستید که می‌خواهید این مدرک را حذف کنید؟</h1>
</div>

<br />

<div class="text-center">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" class="btn btn-danger" value="بله، حذف کن" />
        <a asp-page="/Admin/Index" class="btn btn-secondary">خیر، برگرد</a>
    </form>
</div>
